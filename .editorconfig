[src/EmbedIO/Files/ZipFileProvider.cs]
# Preserve ZipArchive.GetEntry's entryName exception parameter for compatibility.
dotnet_diagnostic.CA2208.severity = none

[src/Shared/AnalyzerUtilities.cs]
# Owner-approved: these IndexOf(char) and Replace overloads are ordinal on every target.
dotnet_diagnostic.CA1307.severity = none

[src/EmbedIO/Http/ServerSentEventWriter.cs]
# Owner-approved: preserve the simple three-character search rather than rewrite for style.
dotnet_diagnostic.CA1870.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0300.severity = none

[src/EmbedIO/Http/HttpExceptionHandler.cs]
# Owner-approved: the no-op handler must retain its public callback parameters.
dotnet_diagnostic.IDE0060.severity = none

[src/EmbedIO/Health/HealthCheckService.cs]
# Preserve the public WaitForReadyAsync parameter order for existing callers.
dotnet_diagnostic.CA1068.severity = none

[src/EmbedIO/Http/Multipart/MultipartReader.Body.cs]
# Owner-approved: preserve the shared array-based stream implementation without target-specific overrides.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Http/Multipart/MultipartReader.cs]
# Preserve the public constructor parameter order for existing callers.
dotnet_diagnostic.CA1068.severity = none

[src/EmbedIO/Http/ServerSentEventHub.cs]
# Preserve the explicit constructor and simple event-name validation implementation.
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1870.severity = none

[src/EmbedIO/Http/ServerSentEventStream.cs]
# Preserve both the response failure and cleanup failure in the intentional AggregateException.
dotnet_diagnostic.CA2219.severity = none

[src/EmbedIO/Idempotency/IdempotencyPolicy.cs]
# Preserve the explicit attribute constructor rather than restructure for a style suggestion.
dotnet_diagnostic.IDE0290.severity = none

[src/EmbedIO/Internal/Compression/CompressionStream.cs]
# Owner-approved: retain shared array-based stream overrides without target-specific branches.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Internal/Diagnostics/ServerTelemetry.cs]
# The .NET Standard fallback intentionally matches the instance API and parameters of active telemetry.
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.IDE0060.severity = none

[src/EmbedIO/Internal/RequestBodies/ReadTimeoutStream.cs]
# The throw guards continuation state inside a task callback; it does not execute as a finally throw.
dotnet_diagnostic.CA2219.severity = none

[src/EmbedIO/Internal/Responses/BufferingResponseStream.cs]
# Owner-approved: retain shared array-based stream overrides without target-specific branches.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Internal/Responses/JsonSequenceWriter.cs]
# Preserve intentional aggregation of operation failures with producer/stream cleanup failures.
dotnet_diagnostic.CA2219.severity = none

[src/EmbedIO/Net/Internal/Http1/Http1ResponseOutput.cs]
# Preserve shared array-based overrides; synchronous=true ValueTask paths perform only synchronous transport I/O.
dotnet_diagnostic.CA1844.severity = none
dotnet_diagnostic.CA2012.severity = none

[src/EmbedIO/Net/Internal/Http2/Http2FrameTransport.cs]
# Preserve the explicit output-write constructor instead of restructuring solely for style.
dotnet_diagnostic.IDE0290.severity = none

[src/EmbedIO/Net/Internal/Http2/Http2RequestBody.cs]
# Owner-approved: retain shared array-based stream overrides without target-specific branches.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Net/Internal/Http3/Http3QuicConnection.cs]
# Preserve coordinated QUIC lifecycle helper signatures; the flagged finally throw is inside a continuation callback.
dotnet_diagnostic.CA1068.severity = none
dotnet_diagnostic.CA2219.severity = none

[src/EmbedIO/Net/Internal/Http3/Http3RequestBody.cs]
# Preserve the existing array-based read implementation without adding an overload solely for this suggestion.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Net/Internal/Http3/QpackEncoder.cs]
# Dictionary.TryAdd is unavailable on .NET Standard 2.0; preserve first-entry-wins initialization.
dotnet_diagnostic.CA1864.severity = none

[src/EmbedIO/Net/Internal/Multiplexed/MultiplexedResponse.cs]
# Preserve shared array-based response stream overrides without target-specific branches.
dotnet_diagnostic.CA1844.severity = none

[src/EmbedIO/Net/Internal/Transport/ListenerPrefix.cs]
# Span-based string.Concat is unavailable on .NET Standard 2.0; retain the shared implementation.
dotnet_diagnostic.CA1845.severity = none
