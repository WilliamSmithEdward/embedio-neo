<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>EmbedIO.DependencyInjection</AssemblyName>
    <PackageId>EmbedIO-Neo.DependencyInjection</PackageId>
    <Description>Optional dependency injection and Generic Host integration for EmbedIO-Neo.</Description>
    <Authors>William Smith; EmbedIO contributors</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/embedio-neo</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- The .NET 10 asset is analyzed for trimming and Native AOT, as the core library is. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EmbedIO/EmbedIO.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <None Include="../../LICENSE" Link="LICENSE" Pack="true" PackagePath="" />
    <Compile Include="../TrimmingAttributes.cs" Link="Internal/TrimmingAttributes.cs" />
  </ItemGroup>
</Project>
