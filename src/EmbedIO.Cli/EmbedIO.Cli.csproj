<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>embedio-cli</ToolCommandName>
    <PackageId>EmbedIO.Neo.Cli</PackageId>
    <Description>EmbedIO-Neo command-line development server.</Description>
    <Authors>William Smith; EmbedIO CLI contributors</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/embedio-neo</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EmbedIO/EmbedIO.csproj" />
    <InternalsVisibleTo Include="EmbedIO.Tests" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../licenses/embedio-cli-LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../CLI.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
