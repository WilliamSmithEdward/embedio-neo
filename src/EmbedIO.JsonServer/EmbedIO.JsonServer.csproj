<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>EmbedIO.JsonServer</AssemblyName>
    <RootNamespace>EmbedIO.JsonServer</RootNamespace>
    <Description>JSON file-backed REST module for EmbedIO-Neo.</Description>
    <Authors>William Smith; EmbedIO contributors</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/embedio-neo</RepositoryUrl>
    <PackageProjectUrl>https://github.com/WilliamSmithEdward/embedio-neo</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EmbedIO/EmbedIO.csproj" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../licenses/embedio-extras-LICENSE" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
