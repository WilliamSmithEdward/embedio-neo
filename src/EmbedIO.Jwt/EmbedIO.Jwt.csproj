<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>EmbedIO.Jwt</AssemblyName>
    <PackageId>EmbedIO-Neo.Jwt</PackageId>
    <Description>Optional explicit-key JWT bearer validation for EmbedIO-Neo.</Description>
    <Authors>William Smith; EmbedIO contributors</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/embedio-neo</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EmbedIO/EmbedIO.csproj" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <None Include="../../LICENSE" Link="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
