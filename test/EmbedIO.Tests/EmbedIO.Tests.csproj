<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../EmbedIO.Performance/ListenerAdmission.cs" Link="BenchmarkTools/ListenerAdmission.cs" />
    <Compile Include="../Shared/HttpsSmoke.cs" Link="PlatformTests/HttpsSmoke.cs" />
    <Compile Include="../Shared/BasicAuthenticationSmoke.cs" Link="PlatformTests/BasicAuthenticationSmoke.cs" />
    <EmbeddedResource Include="Data/StructuredFields/dictionary.json" />
    <EmbeddedResource Include="Data/ParserCorpus/*.tsv" />
    <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit" PrivateAssets="all" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <!-- Drives the controller-binding generator in diagnostics tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates the controller bindings the parity tests register, as a package consumer gets it,
         and is referenced so diagnostics tests can run the generator directly. -->
    <ProjectReference Include="../../src/EmbedIO.Generators/EmbedIO.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmbedIO.Testing\EmbedIO.Testing.csproj" />
    <ProjectReference Include="../../src/EmbedIO.DependencyInjection/EmbedIO.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/EmbedIO.Jwt/EmbedIO.Jwt.csproj" />
    <ProjectReference Include="../../src/EmbedIO.Cli/EmbedIO.Cli.csproj" />
    <ProjectReference Include="../EmbedIO.Cli.TestPlugin/EmbedIO.Cli.TestPlugin.csproj" />
    <ProjectReference Include="..\..\src\EmbedIO.JsonServer\EmbedIO.JsonServer.csproj" />
  </ItemGroup>

  <Target Name="CopyCliPluginFixture" AfterTargets="Build">
    <Copy SourceFiles="../EmbedIO.Cli.TestPlugin/bin/$(Configuration)/net10.0/EmbedIO.Cli.TestPlugin.dll;../../src/EmbedIO/bin/$(Configuration)/net10.0/EmbedIO.dll"
          DestinationFolder="$(OutDir)CliPlugins" />
  </Target>
  <ItemGroup><Compile Include="../Shared/BenchmarkEndpoints.cs" Link="PlatformTests/BenchmarkEndpoints.cs" /></ItemGroup>
  <Import Project="../Shared/QuicNativeAssets.targets" />
</Project>
