<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- RequiredRuntime.Check reads this, so the runtime pin is only RuntimeFrameworkVersion. -->
    <AssemblyMetadata Include="RequiredRuntime" Value="$(RuntimeFrameworkVersion)" />
  </ItemGroup>
</Project>
