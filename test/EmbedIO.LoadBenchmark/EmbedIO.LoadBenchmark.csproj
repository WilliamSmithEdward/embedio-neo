<Project Sdk="Microsoft.NET.Sdk">
  <!-- Separate-process load comparison harness. Test-only, never packed, kept out of EmbedIO.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Both engines run under the same GC configuration; the orchestrator records it. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel comes from the installed ASP.NET Core shared framework; no package download. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/EmbedIO/EmbedIO.csproj" />
  </ItemGroup>
</Project>
