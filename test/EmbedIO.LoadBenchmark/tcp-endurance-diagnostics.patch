@@ -0,0 +1,72 @@
+using System.Collections;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Reflection;
+using System.Net.Sockets;
+using System.Text.Json;
+using EmbedIO;
+
+internal static class TcpEvidence
+{
+    private static long _next;
+    private static readonly ConcurrentDictionary<object, int> Owners = new();
+    internal static long Next() => Interlocked.Increment(ref _next);
+    internal static void Write(object value) => Console.Error.WriteLine(JsonSerializer.Serialize(value));
+    internal static void Remember(IHttpListener listener, int generation, string phase)
+    {
+        var owner = (object)listener;
+        var sessionField = owner.GetType().GetField("_session", BindingFlags.Instance | BindingFlags.NonPublic);
+        if (sessionField != null)
+        {
+            var session = sessionField.GetValue(owner) ?? throw new InvalidOperationException("No combined session.");
+            owner = session.GetType().GetField("_tcp", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(session)
+                ?? throw new InvalidOperationException("No combined TCP owner.");
+        }
+        var type = typeof(EmbedIO.Net.EndPointManager);
+        var gate = type.GetField("RegistrationLock", BindingFlags.Static | BindingFlags.NonPublic)?.GetValue(null)
+            ?? throw new InvalidOperationException("Missing registration gate.");
+        lock (gate)
+        {
+            var map = (IDictionary)(type.GetField("Registrations", BindingFlags.Static | BindingFlags.NonPublic)?.GetValue(null)
+                ?? throw new InvalidOperationException("Missing registration map."));
+            var prefixes = (IDictionary)(map[owner] ?? throw new InvalidOperationException("Missing registered owner."));
+            foreach (IEnumerable endpoints in prefixes.Values)
+                foreach (var endpoint in endpoints) Owners[endpoint] = generation;
+        }
+        Record(phase);
+    }
+    private static string? Local(Socket socket)
+    {
+        try { return socket.SafeHandle.IsClosed ? "closed" : socket.LocalEndPoint?.ToString(); }
+        catch (ObjectDisposedException) { return "closed-during-snapshot"; }
+    }
+    internal static void Record(string phase)
+    {
+        ThreadPool.GetAvailableThreads(out var workers, out var io);
+        foreach (var (endpoint, generation) in Owners)
+        {
+            var type = endpoint.GetType();
+            var socket = (Socket)(type.GetProperty("ListeningSocket", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(endpoint)
+                ?? throw new InvalidOperationException("Missing TCP socket."));
+            var task = (Task)(type.GetField("_acceptWorker", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(endpoint)
+                ?? throw new InvalidOperationException("Missing TCP worker."));
+            var args = new object?[] { null };
+            var gotPending = type.GetMethod("TryPendingConnections", BindingFlags.Instance | BindingFlags.NonPublic)?.Invoke(endpoint, args) as bool?;
+            Write(new
+            {
+                kind = "tcp-endpoint",
+                utc = DateTime.UtcNow,
+                phase,
+                generation,
+                id = System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(endpoint),
+                local = Local(socket),
+                closed = socket.SafeHandle.IsClosed,
+                worker = task.Status.ToString(),
+                fault = task.Exception?.ToString(),
+                pending = gotPending == true && args[0] is Array pending ? pending.Length : -1,
+                availableWorkers = workers,
+                availableIo = io
+            });
+        }
+    }
+}
