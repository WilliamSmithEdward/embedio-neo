<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <ProjectReference Include="../../../src/EmbedIO/EmbedIO.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- The forced standard asset exposes the BCL package's async interfaces; its
         netstandard2.1 forwarding asset unifies them with the modern host types.
         Normal package consumers choose their matching EmbedIO target automatically. -->
    <!-- Exercise the actual standard asset on the modern shared-framework host.
         The legacy-runtime probes separately exercise its pinned serializer packages. -->
  </ItemGroup>
</Project>
