<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <ProjectReference Include="../../../src/EmbedIO/EmbedIO.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- EmbedIO references System.Text.Json only for netstandard2.0, so it does not
         flow to this net10.0 host through the forced standard reference. The standard
         asset binds to the package's assembly version, which can be newer than the
         shared framework's, so the host carries the package itself. -->
    <PackageReference Include="System.Text.Json" />
    <!-- The forced standard asset exposes the BCL package's async interfaces; its
         netstandard2.1 forwarding asset unifies them with the modern host types.
         Normal package consumers choose their matching EmbedIO target automatically. -->
    <!-- Exercise the actual standard asset on the modern shared-framework host.
         The legacy-runtime probes separately exercise its pinned serializer packages. -->
  </ItemGroup>
</Project>
