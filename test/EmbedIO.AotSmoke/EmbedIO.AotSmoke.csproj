<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only Native AOT host, outside the ordinary solution and packages. Published with
       PublishAot; warnings are errors, so any trim or AOT warning reachable from it fails. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EmbedIO/EmbedIO.csproj" />
  </ItemGroup>
  <!-- A package consumer gets this from the package's buildTransitive folder. -->
  <Import Project="../../src/EmbedIO/Packaging/EmbedIO-Neo.targets" />
</Project>
