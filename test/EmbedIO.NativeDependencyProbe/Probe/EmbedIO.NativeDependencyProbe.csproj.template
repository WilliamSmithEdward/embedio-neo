<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EmbedIO-Neo.Native.MsQuic.Candidate" VersionOverride="[0.0.0-local]" />
    <Compile Include="$(ProbeSourceRoot)/test/EmbedIO.NativeDependencyProbe/Probe/Program.cs" Link="Program.cs" />
    <Compile Include="$(ProbeSourceRoot)/test/EmbedIO.RuntimeCloseProbe/QuicRebindProbe.cs" Link="QuicRebindProbe.cs" />
  </ItemGroup>
</Project>