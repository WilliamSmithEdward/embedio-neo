<Project>

  <ItemGroup>
    <!-- Optional JWT adapter only; core authentication has no IdentityModel dependency. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <!-- Property generation and shrinking in the nonpackable fuzz harness only. -->
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <!-- Test-only forced-standard-asset host needs the async-interface forwarding assembly. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" Condition="'$(MSBuildProjectName)' == 'NeoStandard'" />
    <!-- The source generator's compiler API. 4.8 is the Roslyn of the .NET 8 SDK; a newer
         version would stop the generator loading in older supported SDKs. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.13" />
  </ItemGroup>

</Project>
