{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/EmbedIO/**/*.cs"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "xrefService": "https://xref.docs.microsoft.com/query?uid={uid}",
    "template": [
      "default"
    ],
    "content": [
      {
        "files": [
          "**/*.yml"
        ],
        "cwd": "obj/api",
        "dest": "api"
      },
      {
        "files": [
          "README.md",
          "CONTRIBUTING.md",
          "CODE_OF_CONDUCT.md",
          "SECURITY.md",
          "CHANGELOG.md",
          "CLI.md",
          "MIGRATION.md",
          "docs/**/*.md",
          "docs/**/toc.yml"
        ]
      },
      {
        "files": [
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "LICENSE",
          "licenses/**",
          "docs/project/evidence/*.json",
          "images/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "EmbedIO-Neo",
      "_enableSearch": true,
      "_appLogoPath": "images/embedio_neo.png",
      "_appFaviconPath": "images/embedio_neo_icons.png"
    },
    "dest": "_site"
  }
}
