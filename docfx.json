{
  "metadata": [
    {
      "src": [
        {
          "files": [ "src/EmbedIO/**/*.cs" ],
          "exclude": [ "**/bin/**", "**/obj/**" ]
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "xrefService": "https://xref.docs.microsoft.com/query?uid={uid}",
    "template": [
      "default"
    ],
    "content": [
      {
        "files": [ "**/*.yml" ],
        "cwd": "obj/api",
        "dest": "api"
      },
      {
        "files": [ "README.md", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md", "MIGRATION.md", "CLI.md", "docs/embed_io_neo.md" ]
      },
      {
        "files": [ "toc.yml" ]
      }
    ],
    "resource": [
      {
        "files": [ "LICENSE", "licenses/**", "images/**" ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "EmbedIO-Neo",
      "_enableSearch": true, "_appLogoPath": "images/embedio_neo.png", "_appFaviconPath": "images/embedio_neo_icons.png",
      "_docfxVersion": "2.45.0.0"
    },
    "dest": "_site"
  }
}
